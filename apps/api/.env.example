# Copier en .env.local (dev) - NE JAMAIS committer de vraies valeurs.
# En production : ces valeurs viennent d'un secrets manager (Doppler / AWS Secrets
# Manager / HashiCorp Vault), jamais d'un fichier .env sur le serveur.

NODE_ENV=development
PORT=4000

# --- Base de donnees ---
DATABASE_URL="postgresql://csc_dev:change_me_dev_only@localhost:5433/csc_dev?schema=public"

# --- Redis (rate limiting distribue + blacklist JWT) ---
REDIS_URL="redis://:change_me_dev_only@localhost:6379"

# --- JWT ---
# Generer avec: openssl rand -base64 64
JWT_ACCESS_SECRET="change_me_generate_a_real_64B_secret"
JWT_REFRESH_SECRET="change_me_generate_a_different_64B_secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
JWT_ISSUER="cathedrale-sacre-coeur"

# --- Cookies ---
# Doit matcher le domaine reel en prod, jamais un wildcard.
COOKIE_DOMAIN="localhost"
REFRESH_COOKIE_NAME="csc_refresh_token"

# --- CORS ---
# Liste blanche exacte, separee par des virgules. Jamais "*".
CORS_ORIGINS="http://localhost:3000"

# --- Rate limiting ---
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT_DEFAULT=100
THROTTLE_LIMIT_AUTH=5

# --- Observabilite ---
LOG_LEVEL=info
