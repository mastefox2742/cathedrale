# Copier en .env.local - NE JAMAIS committer de vraies valeurs.
#
# REGLE DE SECURITE : seules les variables prefixees NEXT_PUBLIC_ sont
# envoyees au navigateur. Toute cle secrete (API tierce, service key) doit
# rester SANS ce prefixe et n'etre lue que dans du code serveur
# (Server Components, Route Handlers) - jamais dans un composant "use client".

# URL publique de l'API NestJS (accessible depuis le navigateur)
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"

NEXT_PUBLIC_APP_NAME="Cathédrale Sacré-Cœur de Brazzaville"
