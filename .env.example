# Fichier pour docker-compose (dev local uniquement).
# Copier en .env, ne JAMAIS committer .env avec de vraies valeurs.
POSTGRES_USER=csc_dev
POSTGRES_PASSWORD=change_me_dev_only
POSTGRES_DB=csc_dev
# Port hote expose par le conteneur Postgres. 5433 par defaut (pas 5432) pour
# eviter tout conflit avec une instance Postgres locale deja installee.
POSTGRES_PORT=5433
REDIS_PASSWORD=change_me_dev_only
